# Canonical HomeOSS schedules. Use three-letter English weekday names.
SCHEDULE_TIMEZONE=Asia/Hong_Kong

IMMICH_BACKUP_DAYS=Tue
IMMICH_BACKUP_TIME=02:45
IMMICH_BACKUP_RANDOM_DELAY=30m
IMMICH_HEALTHCHECK_GRACE_HOURS=12

KOPIA_LOCAL_SNAPSHOT_TIME=03:30
KOPIA_LOCAL_HEALTHCHECK_TIME=04:15
KOPIA_LOCAL_HEALTHCHECK_RANDOM_DELAY=10m
KOPIA_LOCAL_HEALTHCHECK_GRACE_MINUTES=30

KOPIA_CLOUD_SYNC_DAYS=Mon,Thu,Sat
KOPIA_CLOUD_SYNC_TIME=03:30
KOPIA_CLOUD_SYNC_RANDOM_DELAY=30m
KOPIA_CLOUD_HEALTHCHECK_GRACE_HOURS=2

OPENWRT_REBOOT_DAYS=Mon,Fri
OPENWRT_REBOOT_TIME=03:00
OPENWRT_HEALTHCHECK_GRACE_MINUTES=15
