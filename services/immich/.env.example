DB_DATA_LOCATION=/var/lib/immich-postgres
# Pin the tested release. Upgrade this deliberately after reviewing release notes.
IMMICH_VERSION=v3.0.3

# Generate with: openssl rand -hex 32
# Use only A-Za-z0-9 characters.
DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
TZ=Asia/Hong_Kong
