[Unit]
Description=Encrypted Immich backup to China Mobile Cloud
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecCondition=/usr/local/sbin/immich-backup-due
ExecStart=/usr/local/sbin/immich-cloud-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
